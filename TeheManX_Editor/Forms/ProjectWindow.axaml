<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        xmlns:local="clr-namespace:TeheManX_Editor.Forms"
        x:Class="TeheManX_Editor.Forms.ProjectWindow"
        Title="Project Settings" Height="360" Width="385" CanResize="False" WindowStartupLocation="CenterScreen" Closing="Window_Closing">
    <Window.Styles>
        <Style Selector="CheckBox">
			<Setter Property="FontSize" Value="15"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="Label">
			<Setter Property="FontSize" Value="20"/>
        </Style>
        <Style Selector="TextBlock">
			<Setter Property="FontSize" Value="15"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style Selector="local|NumInt">
			<Setter Property="Width" Value="100"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="FontSize" Value="16"/>
        </Style>
        <Style Selector="Separator">
			<Setter Property="Margin" Value="0,5"/>
        </Style>
    </Window.Styles>
    <Grid>
        <ScrollViewer AllowAutoHide="False">
            <StackPanel>
                <Grid x:Name="expandMB4Grid">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="auto"/>
                    </Grid.ColumnDefinitions>
                    <Button x:Name="expandBtn" Click="expandBtn_Click">Enable 4MB Expansion</Button>
                    <Button x:Name="expansionHelpBtn" Click="expansionHelpBtn_Click" Width="30" Grid.Column="1">?</Button>
                </Grid>

                <CheckBox x:Name="enemyCheck" Checked="CheckBox_Changed">Track Enemy Data in JSON</CheckBox>
                <CheckBox x:Name="paletteCheck" Checked="CheckBox_Changed">Track Palette Swap Data in JSON</CheckBox>
                <CheckBox x:Name="checkpointCheck" Checked="CheckBox_Changed">Track Checkpoint Data in JSON</CheckBox>
                <CheckBox x:Name="cameraCheck" Checked="CheckBox_Changed">Track Camera Data in JSON</CheckBox>
                <CheckBox x:Name="bgTileCheck" Checked="CheckBox_Changed">Track Background Tiles Settings Data in JSON</CheckBox>
                <CheckBox x:Name="objTileCheck" Checked="CheckBox_Changed">Track Object Tiles Settings Data in JSON</CheckBox>

                <StackPanel Orientation="Horizontal">
                    <TextBlock  Width="263">Enemy Data Dump Offset</TextBlock>
                    <local:NumInt Minimum="0" FontSize="16"  x:Name="enemyOffsetInt" ValueChanged="Int_ValueChanged"></local:NumInt>
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock  Width="263">Palette Swap Data Dump Offset</TextBlock>
                    <local:NumInt Minimum="0" FontSize="16"  x:Name="paletteOffsetInt" ValueChanged="Int_ValueChanged"></local:NumInt>
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock  Width="263">Palette Swap Color Bank</TextBlock>
                    <local:NumInt Minimum="0" FontSize="16"  x:Name="paletteBankInt" ValueChanged="Int_ValueChanged"></local:NumInt>
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock  Width="263">Checkpoint Data Dump Offset</TextBlock>
                    <local:NumInt Minimum="0" FontSize="16"  x:Name="checkpointInt" ValueChanged="Int_ValueChanged"></local:NumInt>
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock  Width="263">Camera Trigger Data Dump Offset</TextBlock>
                    <local:NumInt Minimum="0" FontSize="16"  x:Name="cameraTriggerInt" ValueChanged="Int_ValueChanged"></local:NumInt>
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock  Width="263">Camera Border Data Dump Offset</TextBlock>
                    <local:NumInt Minimum="0" FontSize="16"  x:Name="cameraBorderInt" ValueChanged="Int_ValueChanged"></local:NumInt>
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock   Width="263">Background Tile Data Dump Offset</TextBlock>
                    <local:NumInt Minimum="0" FontSize="16"  x:Name="bgTileInt" ValueChanged="Int_ValueChanged"></local:NumInt>
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock  Width="263">Object Tile Data Dump Offset</TextBlock>
                    <local:NumInt Minimum="0" FontSize="16"  x:Name="objTileInt" ValueChanged="Int_ValueChanged"></local:NumInt>
                </StackPanel>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="auto"/>
                    </Grid.ColumnDefinitions>
                    <Button x:Name="projectTrackPatchBtn" Click="projectTrackPatchBtn_Click">Apply Local Project Track Patch</Button>
                    <Button x:Name="projectTrackHelpBtn" Click="projectTrackHelpBtn_Click" Width="30" Grid.Column="1">?</Button>
                </Grid>
                <Separator/>

                <Label HorizontalAlignment="Center">Length Settings</Label>
                <CheckBox x:Name="tileLengthCheck">Track Tile Length in JSON</CheckBox>
                <StackPanel Orientation="Horizontal">
                    <local:NumInt FontSize="16"  x:Name="stageInt" ValueChanged="stageInt_ValueChanged"></local:NumInt>
                    <TextBlock  Width="263">Selected Stage</TextBlock>
                </StackPanel>
                <StackPanel>
					<RadioButton x:Name="layer1Btn" Content="Layer 1" Checked="layer1Btn_Checked" IsChecked="True"/>
                    <RadioButton x:Name="layer2Btn" Content="Layer 2" Checked="layer2Btn_Checked"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock  Width="263">Tile 32x32 Count</TextBlock>
                    <local:NumInt Minimum="1" Maximum="65536" FontSize="16"  x:Name="tile32Int" ValueChanged="tile32Int_ValueChanged"></local:NumInt>
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock  Width="263">Tile 16x16 Count</TextBlock>
                    <local:NumInt Minimum="1" Maximum="65536" FontSize="16"  x:Name="tile16Int" ValueChanged="tile16Int_ValueChanged"></local:NumInt>
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock  Width="165">Screen Count</TextBlock>
                    <local:NumInt Minimum="1" Maximum="256" FontSize="16"  x:Name="screenInt"></local:NumInt>
                    <Button x:Name="screenBtn" Click="screenBtn_Click" Margin="5,0">Set Count</Button>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
